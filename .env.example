# Copy to .env and fill in values before deploying

# Database
DB_NAME=webhookdb
DB_USER=webhook
DB_PASSWORD=webhook

# Domain
DOMAIN=hookspy.in

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_256_bit_random_string

# Optional — Slack incoming webhook URL for Pro alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL